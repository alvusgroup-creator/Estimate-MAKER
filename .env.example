# ── Database (Supabase → Project Settings → Database) ──
# App runtime: pooled connection (port 6543, pgbouncer)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: direct connection (port 5432)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Supabase Auth / Storage ──
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""   # sb_secret_... (Project Settings → API Keys)

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI (your key, never the customer's) ──
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-4-5-20251001"

# ── Email (Resend) — leave empty to disable sending (public link still works) ──
RESEND_API_KEY=""
# Must be on a domain verified in Resend. "onboarding@resend.dev" works for testing (only to your own address).
EMAIL_FROM="Estimate Builder <onboarding@resend.dev>"

# ── Stripe (v1.1) ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_PRO=""
